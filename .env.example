# Copy to .env and fill in. .env is git-ignored, never commit it.
# Load it before starting the backend:  set -a && source ../.env && set +a   (from backend/)

# ── Your account (profile "local") ──────────────────────────────────────────
# Created on first start. The application refuses to start with the placeholder
# or a password shorter than 8 characters. Both can be changed later in Settings.
TP_USERNAME=viktor
TP_PASSWORD=change-me

# ── Database (docker compose up -d postgres) ────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/threatpulse
DATABASE_USERNAME=threatpulse
DATABASE_PASSWORD=secret

# ── Security ────────────────────────────────────────────────────────────────
# Base64 secret of at least 32 bytes:  openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:9000

# ── AI and data sources (all optional, features degrade without them) ──────
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
NVD_API_KEY=

# ── Email alerts (optional, off by default) ─────────────────────────────────
# Needs a sender address on a domain verified at resend.com.
EMAIL_ALERTS_ENABLED=false
EMAIL_ALERTS_TO=
RESEND_API_KEY=
RESEND_SOURCE_EMAIL=
